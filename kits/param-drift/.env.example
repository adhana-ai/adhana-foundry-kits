# Copy to .env and fill in. .env is gitignored.
#
# THEIR PROVIDER, NOT OURS. Use whichever provider you already hold a key for -- a kit that
# hardcodes one vendor is broken for most of the people who fork it. PROVIDER picks the adapter,
# MODEL picks the model behind it, and swapping either is this file plus one more run.
#
# You do NOT need a key to see the kit work. The parameters and their observed windows ship in the
# repo, so `python -m src.app` renders the parameter/window panel and the free floor's own verdict
# offline. A key is needed only to actually call the model or to run the eval against your own
# numbers.

PROVIDER=openai-compatible
BASE_URL=https://api.openai.com/v1
API_KEY=
MODEL=

# Not used by this kit -- it never embeds anything, it makes one review call per parameter. Left
# in for shape-parity with the shared .env every kit reads; a blank value here is never an error.
EMBED_MODEL=
