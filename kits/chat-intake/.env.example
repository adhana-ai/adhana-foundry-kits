# Copy to .env and fill in. .env is gitignored.
#
# THEIR PROVIDER, NOT OURS. Use whichever provider you already hold a key for -- a kit that
# hardcodes one vendor is broken for most of the people who fork it. PROVIDER picks the adapter,
# MODEL picks the model behind it, and swapping either is this file plus one more run.
#
# ⚑ YOU PROBABLY DO NOT NEED THIS FILE. src/config.py reads <repo>/.env first, so one shared
# connection at the repo root serves every kit. This file is the OVERRIDE -- use it only to point
# THIS kit at a different model, and it merges key by key, so a file holding nothing but MODEL
# keeps the shared provider and key.
#
# You do NOT need a key to see the kit work. `python3 -m src.app` steps through real conversations
# in REPLAY -- the dataset's own dialogue state, labelled as such -- and `python3 -m evals.baseline`
# measures the floor. A key is needed only to have a model read the turns and answer beside them.
#
# ⚠︎ YOU DO NEED THE CORPUS, WHICH IS NEW FOR THIS KIT. It is CC BY-SA 4.0 and this repo is MIT, so
# the conversations are fetched rather than committed:
#     python3 -m tools.fetch_corpus && python3 -m tools.build_corpus

PROVIDER=openai-compatible
BASE_URL=https://api.openai.com/v1
API_KEY=
MODEL=

# Not used by this kit -- chat-intake never embeds anything, it makes one extraction call per turn.
# Left in for shape-parity with the shared .env every kit reads; a blank value here is never an
# error.
EMBED_MODEL=
