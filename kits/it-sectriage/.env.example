# Copy to .env and fill in. .env is gitignored.
#
# THEIR PROVIDER, NOT OURS. Use whichever provider you already hold a key for -- a kit that
# hardcodes one vendor is broken for most of the people who fork it. PROVIDER picks the adapter,
# MODEL picks the model behind it, and swapping either is this file plus one more run.
#
# ⚑ YOU DO NOT NEED A KEY TO SEE THIS KIT WORK. Everything up to the model call is pure code and
# already committed: the corpus (tools/build_corpus.py, byte-identical from a fixed seed), the
# free floor (evals/baseline.py -- a keyword-and-shared-indicator rule scored the same way a real
# run is), and the panel (src/app.py -- renders every window and the gold answer with no key at
# all).
#
#     python3 tools/build_corpus.py --verify   # the corpus, and gold re-derived from it, 0 drift
#     python3 -m evals.baseline                # the free floor, 0 calls, $0.00
#     python3 -m evals.run --run-id t000 --stub  # proves the call -> parse -> score wiring, $0.00
#     python3 -m src.app                       # the panel; nothing is sent anywhere until you click
#
# A key is needed only to ask the model about one window (one call per click) or to run the real
# eval (evals/run.py without --stub -- one call per case window).
#
# ⚠︎ IF THIS KIT SITS INSIDE THE KITS REPO, IT ALREADY INHERITS THE ROOT .env AND THEREFORE A LIVE
# KEY. "I have not configured anything yet" is not the same as "nothing can spend". Check
# /api/state, or read src/budget.py's plan() before touching anything that calls out.

PROVIDER=openai-compatible
BASE_URL=https://api.openai.com/v1
API_KEY=
MODEL=

# No EMBED_MODEL: nothing is embedded. A case window is judged from its own alerts and their own
# indicators -- there is no retrieval step in this kit.
