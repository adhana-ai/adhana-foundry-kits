# Fill in the two blanks below. Leave them EMPTY rather than putting a placeholder in:
# config.has_key() tests whether API_KEY is non-empty, so "<the same key>" reads as a real
# credential and the kit fails at the HTTP layer instead of saying the model half was skipped.
#
# THEIR PROVIDER, NOT OURS. Use whichever provider you already hold a key for -- a kit that
# hardcodes one vendor is broken for most of the people who fork it. PROVIDER picks the adapter,
# MODEL picks the model behind it, and swapping either is this file plus one more run.
#
# You do NOT need a key to see the kit work. The cycles, their plan views and their planning
# notes ship in the repo, so `python -m src.app` renders the material-gap panel and the notes log
# offline. A key is needed only to actually call the model or to run the eval against your own
# cycles.

PROVIDER=openai-compatible
BASE_URL=https://api.openai.com/v1
API_KEY=
MODEL=

# Not used by this kit -- it never embeds anything, it makes one drafting call per cycle. Left in
# for shape-parity with the shared .env every kit reads; a blank value here is never an error.
EMBED_MODEL=
