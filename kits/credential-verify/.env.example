# Copy to .env and fill in. .env is gitignored.
#
# THEIR PROVIDER, NOT OURS. Use whichever provider you already hold a key for -- a kit that
# hardcodes one vendor is broken for most of the people who fork it. PROVIDER picks the adapter,
# MODEL picks the model behind it, and swapping either is this file plus one more run.
#
# You do NOT need a key to see the kit work. The corpus, the index and the recorded results ship
# in the repo, so `python -m src.app` renders real output offline. A key is needed only to ask a
# NEW question or to re-run the eval against your own numbers.

PROVIDER=openai-compatible
BASE_URL=https://api.openai.com/v1
API_KEY=
MODEL=

# Embeddings. Only needed if you rebuild the index -- which you do when you point the kit at your
# own documents. Leave blank to use the checked-in index, or the keyword retriever, both of which
# need nothing.
EMBED_MODEL=
