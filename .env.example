# THE SHARED CONNECTION — set this once, and every kit in this repo uses it.
#
# Copy to `.env` beside this file, fill it in, and you are done. Not once per kit: the second
# kit and the two-hundredth read this same file with nothing to configure. That is the whole
# point — if setting up a use case costs a config file, the cost grows with the number of use
# cases, and a kit is supposed to make the next one cheap.
#
#   cp .env.example .env && chmod 600 .env
#
# A kit may still override any of these with its own kits/<slug>/.env, and it is merged KEY BY
# KEY — a kit-local file holding only MODEL points that one kit at a different model and keeps
# the shared provider, base URL and key. Real environment variables beat both.
#
# ⚠︎ .env is gitignored at every depth and always has been. This repo has never held a
# credential. The kits run on your machine, with your key, and nothing is sent to us.

# openai-compatible covers OpenAI, DeepSeek, Groq, Together, Mistral, xAI, and any local
# server (Ollama, LM Studio, vLLM). Use `anthropic` for the Messages API.
PROVIDER=openai-compatible

# The API root, without a trailing path. e.g. https://api.deepseek.com/v1
BASE_URL=

API_KEY=

# No default, on purpose: a kit that picks a model for you has picked your bill and your
# latency too.
MODEL=

# Only used by kits that embed. Leave empty otherwise.
EMBED_MODEL=

# A ceiling on live calls per calendar day, counted across EVERY kit under this file — because
# they all spend the one key above. Leave it empty and there is no cap; the kits will say so out
# loud before every run rather than letting you assume there is one.
#
# It counts CALLS, not dollars. This repo does not know your rate card — you may be on a local
# server, a free tier or an enterprise contract — and a cap that quietly prices you off the wrong
# card is worse than no cap. Multiply by your own rate if you want a figure in money.
#
# For scale: a full run of docs-extract is 57 calls, and one of docs-qa is 100.
MAX_CALLS_PER_DAY=
