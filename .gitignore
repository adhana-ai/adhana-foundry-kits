# Your provider key lives here. It is gitignored from the first commit and this repo has never
# held a credential -- the kit runs on your machine, with your key, and nothing is sent to us.
.env

__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store

# Run output. The RECORDED run is checked in under kits/*/results/ so a fresh clone shows real
# results with no key; this is the scratch directory your own runs write to.
runs/
data/_fetched/
