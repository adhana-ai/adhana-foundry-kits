# Your provider key lives here. It is gitignored from the first commit and this repo has never
# held a credential -- the kit runs on your machine, with your key, and nothing is sent to us.
.env

__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store

# Run output. The RECORDED run is checked in under kits/*/results/ so a fresh clone shows real
# results with no key; this is the scratch directory your own runs write to.
runs/
# The raw HTML fetch_corpus.py downloads; build_corpus.py turns it into the corpus that ships.
# NO LEADING PATH ON PURPOSE. Written as `data/_fetched/` this matched nothing: a pattern with an
# internal slash is anchored to the .gitignore's own directory, and the real path is
# kits/<kit>/data/_fetched/. The files had already been untracked by hand, so the repo looked
# correct while the rule meant to keep them out matched no path at all.
_fetched/
# The shared daily call ledger (src/budget.py). One line per live call, so it is machine-local
# state and not a repo fact -- and it records which kit and which model, which is nobody's
# business but the person holding the key.
.calls-ledger.jsonl
