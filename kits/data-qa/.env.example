# Copy to .env and fill in. .env is gitignored.
#
# THEIR PROVIDER, NOT OURS. Use whichever provider you already hold a key for -- a kit that
# hardcodes one vendor is broken for most of the people who fork it. PROVIDER picks the adapter,
# MODEL picks the model behind it, and swapping either is this file plus one more run.
#
# You do NOT need a key to see this kit work. The database is generated from a fixed seed by
# tools/build_db.py and the recorded run ships in results/, so `python3 -m src.app` renders real
# output offline. A key is needed only to ask a NEW question or to re-run the eval.
#
# ⚠︎ THIS KIT HAS NO FREE SCORING HALF. Other kits in this repo can score part of their pipeline
# with no key because that part is pure code. Here every score needs a generated query, and
# generating one needs the model. `python3 evals/run.py --dry-run` prints what a run would spend
# and calls nothing.

PROVIDER=openai-compatible
BASE_URL=https://api.openai.com/v1
API_KEY=
MODEL=

# No EMBED_MODEL: there is no retrieval step and nothing is embedded. The whole schema goes into
# the prompt, which is honest at this size and is the kit's stated breaks_at_scale limit.
