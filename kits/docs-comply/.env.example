# Copy to .env and fill in. .env is gitignored.
#
# THEIR PROVIDER, NOT OURS. Use whichever provider you already hold a key for -- a kit that
# hardcodes one vendor is broken for most of the people who fork it. PROVIDER picks the adapter,
# MODEL picks the model behind it, and swapping either is this file plus one more run.
#
# You do NOT need a key to see the kit work. The corpus and the labelled spans ship in the repo,
# so `python -m src.app` renders the document panel offline. A key is needed only to actually
# call the detector or to run the eval against your own numbers.

PROVIDER=openai-compatible
BASE_URL=https://api.openai.com/v1
API_KEY=
MODEL=

# Not used by this kit -- docs-redact never embeds anything, it makes one detection call per
# document. Left in for shape-parity with the shared .env every kit reads; a blank value here is
# never an error.
EMBED_MODEL=
